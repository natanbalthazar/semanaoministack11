# Regras que valem para o repositório inteiro.
# Cada app (backend/, frontend/, mobile/) tem o próprio .gitignore com o que é específico dele.

node_modules/

# Sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# Variáveis de ambiente locais (podem ter dados sensíveis). Os arquivos *.example são versionados.
.env
.env.*
!.env*.example

# Saídas de ferramentas de teste/inspeção
coverage/
.playwright-mcp/
