# Copie para .env.local (que não vai para o git) e ajuste se o backend estiver em outro endereço.
# NEXT_PUBLIC_* fica visível no navegador e é embutida no build: nada de segredos aqui.
NEXT_PUBLIC_API_URL=http://localhost:3333
# O backend só aceita chamadas do navegador vindas das origens em CORS_ORIGIN (backend/.env).
# Rodando o front em outra porta/domínio (ex.: http://localhost:3100)? Inclua-o lá também.
