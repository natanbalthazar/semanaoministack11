# Copie para .env (que NÃO vai para o git): cp .env.example .env
# Os scripts `pnpm dev` e `pnpm start` carregam o .env sozinhos (flag nativa do Node --env-file-if-exists).

# Segredo que assina os tokens de login. Obrigatório em produção (mínimo 32 caracteres).
# Sem ele, em dev, o servidor gera um aleatório a cada start → reiniciou, todos precisam logar de novo.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazou? Troque o valor: todos os tokens emitidos com o antigo deixam de valer.
AUTH_SECRET=

# Porta da API (padrão 3333).
PORT=3333

# Origens (sites) que o navegador pode usar para chamar a API, separadas por vírgula.
# Padrão: Next dev + Expo web.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
